{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Browser-sync (recommended)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["browser-sync", "start", "--server", "--files", "**/*.html,**/*.css,images/**"],
      "port": 3000
    },
    {
      "name": "Python static server",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3000"],
      "port": 3000
    },
    {
      "name": "Node static server (npx serve)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", ".", "--listen", "3001"],
      "port": 3001
    }
  ]
}
