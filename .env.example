# ─────────────────────────────────────────────────────────────────────────────
# Premodel v1 — environment variables
# Set these in the Vercel project (Settings → Environment Variables), NOT in git.
# Copy to .env.local for local `vercel dev`.
# ─────────────────────────────────────────────────────────────────────────────

# --- Slack (intake notifications + interactive "Push to Notion CRM" button) ---
# Create a Slack app (manifest in docs/slack-app-manifest.json), install to the
# workspace, then copy the Bot User OAuth Token (starts with xoxb-).
SLACK_BOT_TOKEN=xoxb-your-bot-token
# App-level Signing Secret (Basic Information → App Credentials). Used to verify
# that interactivity requests genuinely came from Slack.
SLACK_SIGNING_SECRET=your-signing-secret
# Channel the lead notifications are posted to (channel ID like C0123ABCD, or #name).
SLACK_LEADS_CHANNEL=C00000000

# --- Notion (lead is written here ONLY when the Slack button is clicked) ---
# Internal integration token (starts with secret_ or ntn_). Share the CRM
# database with this integration in Notion.
NOTION_API_KEY=secret_your-notion-token
# The CRM database ID. This is the real "CRM Database" id (not a secret); the
# token above is what gates access. Share that database with your integration.
NOTION_DATABASE_ID=2faabc3f-eabf-80f1-a807-ca058df0ce63
